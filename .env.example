# Copy this file to .env and fill in real values.
# Never commit .env to git (it's already in .gitignore).

# --- Spotify API (https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=changeme
SPOTIFY_CLIENT_SECRET=changeme
# Must exactly match the Redirect URI configured in the Spotify Dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080

# --- Web dashboard login ---
ADMIN_USERNAME=changeme
ADMIN_PASSWORD=changeme
# Generate with e.g.: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=changeme

# --- Optional settings ---
APP_TITLE=Spotify Live Wrapped
WEB_HOST=0.0.0.0
WEB_PORT=5000
COLLECT_INTERVAL_SECONDS=600
# Absolute path where the database and token cache are stored (default is ./data)
# DATA_DIR=/opt/spotify-live-wrapped/data
