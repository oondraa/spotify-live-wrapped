# Zkopíruj tento soubor na .env a doplň skutečné hodnoty.
# Nikdy .env nenahrávej do gitu (je v .gitignore).

# --- Spotify API (https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=doplnit
SPOTIFY_CLIENT_SECRET=doplnit
# Musí přesně odpovídat Redirect URI nastavené v Spotify Dashboardu.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080

# --- Přihlášení do webového dashboardu ---
ADMIN_USERNAME=doplnit
ADMIN_PASSWORD=doplnit
# Vygeneruj např.: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=doplnit

# --- Volitelné nastavení ---
APP_TITLE=Spotify Live Wrapped
WEB_HOST=0.0.0.0
WEB_PORT=5000
COLLECT_INTERVAL_SECONDS=600
# Absolutní cesta, kam se ukládá databáze a token cache (výchozí je ./data)
# DATA_DIR=/opt/spotify-live-wrapped/data
